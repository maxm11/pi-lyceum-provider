{
  "name": "pi-lyceum-provider",
  "version": "1.0.0",
  "description": "Lyceum Cloud Serverless API provider for the Pi coding agent",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "pi-lyceum-provider": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "extensions",
    "skills",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:tests": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build:tests && node --test dist/tests/*.test.js",
    "setup": "node ./dist/src/cli.js setup",
    "prepublishOnly": "npm run build && npm test"
  },
  "pi": {
    "extensions": [
      "./dist/extensions/index.js"
    ],
    "skills": [
      "./skills/lyceum"
    ]
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-provider",
    "pi",
    "pi-coding-agent",
    "pi-ai",
    "lyceum",
    "lyceum-cloud",
    "llm",
    "ai-agent",
    "provider",
    "serverless"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
